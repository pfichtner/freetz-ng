#!/bin/sh
#
# Freetz-NG Runtime Package Manager
# CLI: pkg status|list|info|update|install|remove|help
#
# Exit codes:
#   0  success
#   1  generic error / usage
#   2  storage unavailable
#   3  package not found
#   4  integrity/compatibility/trust error
#   5  conflict or ownership error
#

PKG_VERSION=1.0
PKG_FORMAT_VERSION=1
PKG_REPO_FORMAT_VERSION=1
PKG_CONFIG=/mod/etc/conf/pkgmanager.cfg

[ -r "$PKG_CONFIG" ] && . "$PKG_CONFIG"

: "${PKG_ROOT:=/var/media/ftp/uStor01/pkgroot}"
: "${PKG_STORAGE_MOUNT:=/var/media/ftp/uStor01}"
: "${PKG_ARCH:=arm-linux-uclibcgnueabi}"
: "${PKG_REPO_URL:=}"
: "${PKG_PUBKEY_FILE:=/etc/pkgmanager/trusted.pub}"
: "${PKG_DOWNLOAD_TIMEOUT:=30}"

PKG_DB="$PKG_ROOT/database/installed"
PKG_JOURNAL="$PKG_ROOT/database/transactions"
PKG_LOCK="$PKG_ROOT/database/.lock"
PKG_CACHE="$PKG_ROOT/cache"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
	echo "pkg: $*" >&2
	exit 1
}

die_code() {
	local code="$1"; shift
	echo "pkg: $*" >&2
	exit "$code"
}

storage_ok() {
	grep -q " $PKG_STORAGE_MOUNT " /proc/mounts || return 1
	[ -d "$PKG_ROOT" ] || return 1
}

require_storage() {
	storage_ok || die_code 2 "storage not available: $PKG_STORAGE_MOUNT is not mounted"
}

init_db_dirs() {
	mkdir -p "$PKG_DB" "$PKG_JOURNAL" "$PKG_CACHE" || \
		die "cannot create database directories under $PKG_ROOT"
}

acquire_lock() {
	local attempts=0
	while ! mkdir "$PKG_LOCK" 2>/dev/null; do
		attempts=$((attempts + 1))
		[ "$attempts" -ge 10 ] && die "another pkg operation is in progress (lock: $PKG_LOCK)"
		sleep 1
	done
}

release_lock() {
	rmdir "$PKG_LOCK" 2>/dev/null
}

cleanup_tmpdir() {
	[ -n "$_PKG_TMPDIR" ] && rm -rf "$_PKG_TMPDIR"
	_PKG_TMPDIR=
}

make_tmpdir() {
	_PKG_TMPDIR=$(mktemp -d "/tmp/pkg.XXXXXX") || die "cannot create temporary directory"
	chmod 700 "$_PKG_TMPDIR"
}

ctrl_get() {
	local field="$1" file="$2"
	sed -n "s/^${field}: //p" "$file" | head -1
}

# Download a URL to a file; uses $PKG_DOWNLOAD_TIMEOUT for read timeout.
pkg_download() {
	local url="$1" dest="$2"
	local tmp="${dest}.dl$$"
	if ! wget -q -T "$PKG_DOWNLOAD_TIMEOUT" -O "$tmp" "$url" 2>/dev/null; then
		rm -f "$tmp"
		return 1
	fi
	mv "$tmp" "$dest"
}

# ---------------------------------------------------------------------------
# pkg status
# ---------------------------------------------------------------------------

cmd_status() {
	echo "Freetz-NG Runtime Package Manager $PKG_VERSION"
	echo "Package root  : $PKG_ROOT"
	echo "Storage mount : $PKG_STORAGE_MOUNT"
	if grep -q " $PKG_STORAGE_MOUNT " /proc/mounts 2>/dev/null; then
		echo "Storage state : mounted"
	else
		echo "Storage state : NOT MOUNTED"
	fi
	if [ -d "$PKG_DB" ]; then
		local count
		count=$(ls "$PKG_DB" 2>/dev/null | wc -l | tr -d ' ')
		echo "Database      : ok ($count package(s) installed)"
	else
		echo "Database      : not initialised"
	fi
	echo "Target arch   : $PKG_ARCH"

	# Repository state
	if [ -n "$PKG_REPO_URL" ]; then
		echo "Repository    : $PKG_REPO_URL"
	else
		echo "Repository    : not configured"
	fi
	local release="$PKG_CACHE/Release"
	if [ -f "$release" ]; then
		local valid_until seq
		valid_until=$(ctrl_get ValidUntil "$release")
		seq=$(ctrl_get Sequence "$release")
		local today
		today=$(date -u '+%Y-%m-%d' 2>/dev/null || echo "unknown")
		if [ -n "$valid_until" ] && [ "$today" \> "$valid_until" ]; then
			echo "Repo index    : EXPIRED (ValidUntil: $valid_until)"
		else
			local pkg_count
			pkg_count=$(grep -c '^Package:' "$PKG_CACHE/Packages" 2>/dev/null || echo 0)
			echo "Repo index    : ok (seq=$seq, valid until $valid_until, $pkg_count package(s))"
		fi
	else
		echo "Repo index    : not cached (run 'pkg update')"
	fi
	if [ -f "$PKG_PUBKEY_FILE" ]; then
		echo "Trust anchor  : $PKG_PUBKEY_FILE"
	else
		echo "Trust anchor  : NOT FOUND ($PKG_PUBKEY_FILE)"
	fi
}

# ---------------------------------------------------------------------------
# pkg list
# ---------------------------------------------------------------------------

cmd_list() {
	require_storage
	if [ ! -d "$PKG_DB" ] || [ -z "$(ls "$PKG_DB" 2>/dev/null)" ]; then
		echo "No packages installed."
		return 0
	fi
	printf "%-24s %s\n" "Name" "Version"
	printf "%-24s %s\n" "------------------------" "-------"
	for ctrl in "$PKG_DB"/*/control; do
		[ -f "$ctrl" ] || continue
		local name version
		name=$(ctrl_get Name "$ctrl")
		version=$(ctrl_get Version "$ctrl")
		printf "%-24s %s\n" "$name" "$version"
	done
}

# ---------------------------------------------------------------------------
# pkg info <name>
# ---------------------------------------------------------------------------

cmd_info() {
	[ -n "$1" ] || die "usage: pkg info <name>"
	require_storage
	local ctrl="$PKG_DB/$1/control"
	[ -f "$ctrl" ] || die_code 3 "package not installed: $1"
	cat "$ctrl"
	echo ""
	echo "Installed-Files:"
	cat "$PKG_DB/$1/manifest" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# pkg update — download and verify repository index
# ---------------------------------------------------------------------------

cmd_update() {
	require_storage
	[ -n "$PKG_REPO_URL" ] || die "no repository configured; set PKG_REPO_URL in pkgmanager.cfg"
	[ -f "$PKG_PUBKEY_FILE" ] || die_code 4 "trust anchor not found: $PKG_PUBKEY_FILE"

	init_db_dirs

	make_tmpdir
	local tmpdir="$_PKG_TMPDIR"

	# Download Release
	echo "pkg: fetching repository index from $PKG_REPO_URL..."
	local tmp_release="$tmpdir/Release"
	pkg_download "$PKG_REPO_URL/Release" "$tmp_release" || {
		cleanup_tmpdir; die "failed to download Release from $PKG_REPO_URL"
	}

	# Download Release.sig
	local tmp_sig_b64="$tmpdir/Release.sig"
	pkg_download "$PKG_REPO_URL/Release.sig" "$tmp_sig_b64" || {
		cleanup_tmpdir; die "failed to download Release.sig"
	}

	# Decode signature and verify
	local tmp_sig_bin="$tmpdir/Release.sig.bin"
	if ! base64 -d "$tmp_sig_b64" > "$tmp_sig_bin" 2>/dev/null; then
		cleanup_tmpdir; die_code 4 "Release.sig is not valid base64"
	fi
	if ! openssl pkeyutl -verify -pubin -inkey "$PKG_PUBKEY_FILE" \
			-rawin -in "$tmp_release" -sigfile "$tmp_sig_bin" >/dev/null 2>&1; then
		cleanup_tmpdir; die_code 4 "repository signature verification failed — index rejected"
	fi

	# Parse Release metadata (signature now verified — fields are trusted)
	local valid_until seq packages_hash fmt_ver
	valid_until=$(ctrl_get ValidUntil "$tmp_release")
	seq=$(ctrl_get Sequence "$tmp_release")
	packages_hash=$(ctrl_get "SHA256-Packages" "$tmp_release")
	fmt_ver=$(ctrl_get FormatVersion "$tmp_release")

	# Format version check
	if [ -n "$fmt_ver" ] && [ "$fmt_ver" != "$PKG_REPO_FORMAT_VERSION" ]; then
		cleanup_tmpdir
		die_code 4 "unsupported repository format version $fmt_ver (expected $PKG_REPO_FORMAT_VERSION)"
	fi

	# Expiry check
	local today
	today=$(date -u '+%Y-%m-%d' 2>/dev/null || echo "")
	if [ -n "$valid_until" ] && [ -n "$today" ] && [ "$today" \> "$valid_until" ]; then
		cleanup_tmpdir
		die_code 4 "repository metadata has expired (ValidUntil: $valid_until, today: $today)"
	fi

	# Anti-downgrade: reject if incoming sequence ≤ cached sequence
	local seq_file="$PKG_CACHE/repo-sequence"
	if [ -f "$seq_file" ] && [ -n "$seq" ]; then
		local cached_seq
		cached_seq=$(cat "$seq_file" 2>/dev/null)
		if [ -n "$cached_seq" ] && [ "$seq" -le "$cached_seq" ] 2>/dev/null; then
			cleanup_tmpdir
			die_code 4 "repository sequence rollback detected (cached=$cached_seq incoming=$seq) — rejected"
		fi
	fi

	# Download Packages index
	local tmp_packages="$tmpdir/Packages"
	pkg_download "$PKG_REPO_URL/Packages" "$tmp_packages" || {
		cleanup_tmpdir; die "failed to download Packages index"
	}

	# Verify Packages hash against the authenticated Release
	local actual_hash
	actual_hash=$(sha256sum "$tmp_packages" | awk '{print $1}')
	if [ "$actual_hash" != "$packages_hash" ]; then
		cleanup_tmpdir
		die_code 4 "Packages index hash mismatch — index rejected"
	fi

	# Atomically commit the verified index to cache
	cp "$tmp_release"   "$PKG_CACHE/Release.tmp"   && mv "$PKG_CACHE/Release.tmp"   "$PKG_CACHE/Release"
	cp "$tmp_sig_b64"   "$PKG_CACHE/Release.sig.tmp" && mv "$PKG_CACHE/Release.sig.tmp" "$PKG_CACHE/Release.sig"
	cp "$tmp_packages"  "$PKG_CACHE/Packages.tmp"  && mv "$PKG_CACHE/Packages.tmp"  "$PKG_CACHE/Packages"
	[ -n "$seq" ] && printf '%s\n' "$seq" > "$seq_file"

	local pkg_count
	pkg_count=$(grep -c '^Package:' "$PKG_CACHE/Packages" 2>/dev/null || echo 0)
	echo "pkg: repository index updated ($pkg_count package(s), valid until $valid_until)"

	cleanup_tmpdir
}

# ---------------------------------------------------------------------------
# Archive validation helpers
# ---------------------------------------------------------------------------

validate_archive_paths() {
	local archive="$1"
	local bad
	bad=$(tar tzf "$archive" 2>/dev/null | grep -E '^/|/\.\.$|/\.\./|\.\./|^\.\.$')
	if [ -n "$bad" ]; then
		echo "$bad"
		return 1
	fi
	return 0
}

validate_data_special_files() {
	local datadir="$1"
	local bad
	bad=$(find "$datadir" \( -type c -o -type b \) 2>/dev/null | head -1)
	[ -z "$bad" ] || return 1
	return 0
}

verify_manifest() {
	local tmpdir="$1"
	local manifest="$tmpdir/CONTROL/manifest"
	local datadir="$tmpdir/data"
	local ok=0
	while IFS= read -r line; do
		[ -z "$line" ] && continue
		local expected_hash filepath
		expected_hash=$(echo "$line" | awk '{print $1}')
		filepath=$(echo "$line" | awk '{print $2}')
		filepath="${filepath#./}"
		local fullpath="$datadir/$filepath"
		if [ ! -f "$fullpath" ]; then
			echo "pkg: manifest entry missing from archive: $filepath" >&2
			ok=1
			continue
		fi
		local actual_hash
		actual_hash=$(sha256sum "$fullpath" | awk '{print $1}')
		if [ "$actual_hash" != "$expected_hash" ]; then
			echo "pkg: digest mismatch for $filepath" >&2
			echo "pkg:   expected $expected_hash" >&2
			echo "pkg:   actual   $actual_hash" >&2
			ok=1
		fi
	done < "$manifest"
	return $ok
}

check_space() {
	local target_dir="$1"
	local source_dir="$2"
	local needed_kb available_kb
	needed_kb=$(du -sk "$source_dir" 2>/dev/null | awk '{print $1}')
	available_kb=$(df -k "$target_dir" 2>/dev/null | awk 'NR==2{print $4}')
	if [ -n "$needed_kb" ] && [ -n "$available_kb" ]; then
		[ "$available_kb" -gt "$needed_kb" ] || return 1
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Core install logic (shared by file and repo paths)
# ---------------------------------------------------------------------------

install_from_file() {
	local archive="$1"

	require_storage
	init_db_dirs
	acquire_lock

	make_tmpdir
	local tmpdir="$_PKG_TMPDIR"

	_cleanup_install() {
		cleanup_tmpdir
		release_lock
	}

	local bad_paths
	bad_paths=$(validate_archive_paths "$archive")
	if [ $? -ne 0 ]; then
		echo "pkg: rejected: dangerous paths in archive:" >&2
		echo "$bad_paths" >&2
		_cleanup_install; exit 4
	fi

	if ! tar xzf "$archive" -C "$tmpdir" 2>/dev/null; then
		echo "pkg: rejected: cannot extract archive (corrupt or not a .fpkg)" >&2
		_cleanup_install; exit 4
	fi

	[ -f "$tmpdir/CONTROL/control" ]  || { echo "pkg: rejected: missing CONTROL/control"  >&2; _cleanup_install; exit 4; }
	[ -f "$tmpdir/CONTROL/manifest" ] || { echo "pkg: rejected: missing CONTROL/manifest" >&2; _cleanup_install; exit 4; }
	[ -d "$tmpdir/data" ]             || { echo "pkg: rejected: missing data/ directory"  >&2; _cleanup_install; exit 4; }

	local name version format_ver arch
	name=$(ctrl_get Name "$tmpdir/CONTROL/control")
	version=$(ctrl_get Version "$tmpdir/CONTROL/control")
	format_ver=$(ctrl_get FormatVersion "$tmpdir/CONTROL/control")
	arch=$(ctrl_get Arch "$tmpdir/CONTROL/control")

	[ -n "$name" ]       || { echo "pkg: rejected: missing Name field"          >&2; _cleanup_install; exit 4; }
	[ -n "$version" ]    || { echo "pkg: rejected: missing Version field"       >&2; _cleanup_install; exit 4; }
	[ -n "$format_ver" ] || { echo "pkg: rejected: missing FormatVersion field" >&2; _cleanup_install; exit 4; }
	[ -n "$arch" ]       || { echo "pkg: rejected: missing Arch field"          >&2; _cleanup_install; exit 4; }

	case "$name" in
		*[!a-zA-Z0-9_-]*) echo "pkg: rejected: invalid package name: $name" >&2; _cleanup_install; exit 4 ;;
	esac

	if [ "$format_ver" != "$PKG_FORMAT_VERSION" ]; then
		echo "pkg: rejected: unsupported package format version $format_ver (expected $PKG_FORMAT_VERSION)" >&2
		_cleanup_install; exit 4
	fi
	if [ "$arch" != "$PKG_ARCH" ]; then
		echo "pkg: rejected: incompatible architecture $arch (this system: $PKG_ARCH)" >&2
		_cleanup_install; exit 4
	fi

	if [ -d "$PKG_DB/$name" ]; then
		local installed_version
		installed_version=$(ctrl_get Version "$PKG_DB/$name/control")
		echo "pkg: error: $name $installed_version is already installed; remove it first" >&2
		_cleanup_install; exit 5
	fi

	if ! validate_data_special_files "$tmpdir/data"; then
		echo "pkg: rejected: archive contains device nodes or other special files" >&2
		_cleanup_install; exit 4
	fi

	if ! verify_manifest "$tmpdir"; then
		echo "pkg: rejected: digest verification failed" >&2
		_cleanup_install; exit 4
	fi

	if ! check_space "$PKG_ROOT" "$tmpdir/data"; then
		echo "pkg: error: insufficient disk space on $PKG_STORAGE_MOUNT" >&2
		_cleanup_install; exit 1
	fi

	local journal="$PKG_JOURNAL/${name}.in-progress"
	printf 'action=install\nname=%s\nversion=%s\narch=%s\n' \
		"$name" "$version" "$arch" > "${journal}.tmp"
	mv "${journal}.tmp" "$journal"

	local err_file="$tmpdir/.err"
	find "$tmpdir/data" -mindepth 1 | while IFS= read -r src; do
		local rel="${src#${tmpdir}/data/}"
		local dst="$PKG_ROOT/$rel"
		if [ -d "$src" ]; then
			mkdir -p "$dst" 2>/dev/null || { echo fail > "$err_file"; break; }
		else
			mkdir -p "${dst%/*}" 2>/dev/null || { echo fail > "$err_file"; break; }
			cp "$src" "${dst}.tmp" 2>/dev/null || { echo fail > "$err_file"; break; }
			mv "${dst}.tmp" "$dst" 2>/dev/null || { echo fail > "$err_file"; break; }
		fi
	done
	if [ -f "$err_file" ]; then
		echo "pkg: error: write failure during installation; package may be partially installed" >&2
		echo "pkg: transaction journal preserved at $journal for recovery" >&2
		_cleanup_install; exit 1
	fi

	mkdir -p "$PKG_DB/$name"
	cp "$tmpdir/CONTROL/control"  "$PKG_DB/$name/control.tmp"  && mv "$PKG_DB/$name/control.tmp"  "$PKG_DB/$name/control"
	cp "$tmpdir/CONTROL/manifest" "$PKG_DB/$name/manifest.tmp" && mv "$PKG_DB/$name/manifest.tmp" "$PKG_DB/$name/manifest"
	rm -f "$journal"

	echo "pkg: installed $name $version"
	_cleanup_install
}

# ---------------------------------------------------------------------------
# Install from repository — looks up authenticated index, downloads, verifies
# ---------------------------------------------------------------------------

install_from_repo() {
	local name="$1"
	local packages_index="$PKG_CACHE/Packages"

	[ -f "$packages_index" ] || \
		die_code 3 "no repository index cached; run 'pkg update' first"

	# Look up the package stanza in the authenticated Packages index
	local stanza
	stanza=$(awk -v pkg="$name" '
		/^[[:space:]]*$/ { in_pkg=0; next }
		/^Package:/ { in_pkg=($2 == pkg) }
		in_pkg { print }
	' "$packages_index")

	[ -n "$stanza" ] || die_code 3 "package not found in repository: $name"

	local version arch filename pkg_hash
	version=$(echo "$stanza"  | sed -n 's/^Version: //p'  | head -1)
	arch=$(echo "$stanza"     | sed -n 's/^Arch: //p'     | head -1)
	filename=$(echo "$stanza" | sed -n 's/^Filename: //p' | head -1)
	pkg_hash=$(echo "$stanza" | sed -n 's/^SHA256: //p'   | head -1)

	[ -n "$filename" ] || die "malformed repository entry for $name (no Filename)"
	[ -n "$pkg_hash" ] || die "malformed repository entry for $name (no SHA256)"

	# Arch check against authenticated repository entry
	if [ -n "$arch" ] && [ "$arch" != "$PKG_ARCH" ]; then
		die_code 4 "repository package $name is for $arch, not $PKG_ARCH"
	fi

	# Download to cache
	[ -n "$PKG_REPO_URL" ] || die "PKG_REPO_URL not set — cannot download $name"
	require_storage
	init_db_dirs

	local archive="$PKG_CACHE/$filename"
	echo "pkg: downloading $name $version..."
	pkg_download "$PKG_REPO_URL/$filename" "${archive}.dl" || \
		die "failed to download $filename from $PKG_REPO_URL"

	# Verify archive digest against authenticated Packages index entry
	local actual_hash
	actual_hash=$(sha256sum "${archive}.dl" | awk '{print $1}')
	if [ "$actual_hash" != "$pkg_hash" ]; then
		rm -f "${archive}.dl"
		die_code 4 "archive digest mismatch for $name — download rejected"
	fi
	mv "${archive}.dl" "$archive"

	install_from_file "$archive"
}

# ---------------------------------------------------------------------------
# pkg install — auto-detect file vs repository name
# ---------------------------------------------------------------------------

cmd_install() {
	[ -n "$1" ] || die "usage: pkg install <name|file.fpkg>"
	case "$1" in
		*.fpkg|/*|./*|../*) install_from_file "$1" ;;
		*)                   install_from_repo "$1" ;;
	esac
}

# ---------------------------------------------------------------------------
# pkg remove <name>
# ---------------------------------------------------------------------------

cmd_remove() {
	[ -n "$1" ] || die "usage: pkg remove <name>"
	local name="$1"

	require_storage
	local ctrl="$PKG_DB/$name/control"
	[ -f "$ctrl" ] || die_code 3 "package not installed: $name"

	local version
	version=$(ctrl_get Version "$ctrl")

	acquire_lock

	local journal="$PKG_JOURNAL/${name}.removing"
	printf 'action=remove\nname=%s\nversion=%s\n' "$name" "$version" \
		> "${journal}.tmp"
	mv "${journal}.tmp" "$journal"

	local manifest="$PKG_DB/$name/manifest"
	if [ -f "$manifest" ]; then
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			local filepath
			filepath=$(echo "$line" | awk '{print $2}')
			filepath="${filepath#./}"
			local fullpath="$PKG_ROOT/$filepath"
			[ -f "$fullpath" ] && rm -f "$fullpath"
		done < "$manifest"
		find "$PKG_ROOT" -mindepth 1 -type d -empty 2>/dev/null | sort -r | while IFS= read -r d; do
			case "$d" in
				"$PKG_ROOT/database"|"$PKG_ROOT/database/"*|"$PKG_ROOT/cache") continue ;;
			esac
			rmdir "$d" 2>/dev/null || true
		done
	fi

	rm -rf "$PKG_DB/$name"
	rm -f "$journal"

	echo "pkg: removed $name $version"
	release_lock
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
	cat >&2 <<'EOF'
Usage: pkg <command> [options]

Commands:
  status            Show manager version, storage and repository state
  list              List installed packages
  info <name>       Show metadata for an installed package
  update            Refresh and verify the repository index
  install <name>    Install a package from the authenticated repository
  install <file>    Install a .fpkg archive from a local file path
  remove <name>     Remove an installed package
  help              Show this help text

Exit codes:
  0  success
  1  error
  2  storage not available
  3  package not found
  4  integrity, compatibility, or trust error
  5  conflict or ownership error
EOF
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

case "$1" in
	status)  cmd_status ;;
	list)    cmd_list ;;
	info)    shift; cmd_info "$@" ;;
	update)  cmd_update ;;
	install) shift; cmd_install "$@" ;;
	remove)  shift; cmd_remove "$@" ;;
	help|--help|-h) usage; exit 0 ;;
	*) usage; exit 1 ;;
esac
