config FREETZ_PACKAGE_SER2NET
	bool "ser2net 3.5.4/4.6.8"
	default n
	help
		Ser2net is a program for allowing network connections to serial
		ports. It supports RFC 2217 (remote control of serial port
		parameters), but you must have a compliant client.
		Configuration format differs by version (see help).

if FREETZ_PACKAGE_SER2NET

	choice
		prompt "Version"
			default FREETZ_PACKAGE_SER2NET_CURRENT

		config FREETZ_PACKAGE_SER2NET_ABANDON
			bool "3.5.4 (legacy)"
			help
				Legacy ser2net 3.5.4 using traditional config format
				(ser2net.conf). Compatible with older build environments.

		config FREETZ_PACKAGE_SER2NET_CURRENT
			bool "4.6.8"
			select FREETZ_LIB_libgensio
			select FREETZ_LIB_libgensioosh
			select FREETZ_LIB_libgensiomdns
			select FREETZ_LIB_libyaml
			select FREETZ_LIB_libpthread if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
			help
				ser2net 4.6.8 using YAML configuration format (ser2net.yaml).
				Requires gensio and yaml libraries.

	endchoice

endif

